{
  "version": 1,
  "name": "diario-fotos",
  "title": "Diario del río",
  "description": "Fotos del río a lo largo del año: sube la tuya con una nota y mira las de los demás.",
  "lang": "es",
  "theme": {
    "primary": "teal",
    "gray": "zinc",
    "colorMode": "light"
  },
  "shell": "shell.json",
  "routes": {
    "/": "galeria.json",
    "/subir": "subir.json"
  },
  "data": {
    "collections": {
      "fotos": {
        "fields": [
          {
            "name": "fotos",
            "type": "json",
            "required": true
          },
          {
            "name": "nota",
            "type": "string"
          },
          {
            "name": "lugar",
            "type": "string"
          }
        ]
      }
    }
  }
}
