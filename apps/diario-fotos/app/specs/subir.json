{
  "version": 1,
  "state": {
    "draft": {},
    "sent": false
  },
  "children": [
    {
      "type": "div",
      "style": "page-narrow",
      "children": [
        {
          "type": "Stack",
          "props": {
            "gap": "lg"
          },
          "children": [
            {
              "type": "Text",
              "props": {
                "as": "h1",
                "text": "Subir una foto"
              }
            },
            {
              "type": "Panel",
              "if": "!$state.sent",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "PhotoDropZone",
                      "props": {
                        "lines": [
                          "Tomar foto",
                          "o",
                          "arrastra tu foto aquí"
                        ],
                        "accept": "image/*"
                      },
                      "on": {
                        "files": {
                          "set": "draft.fotos"
                        }
                      }
                    },
                    {
                      "type": "Text",
                      "if": "$state.draft.fotos",
                      "props": {
                        "size": "xs",
                        "tone": "muted",
                        "text": "Foto lista. Ahora una nota y el lugar."
                      }
                    },
                    {
                      "type": "FormFields",
                      "props": {
                        "fields": [
                          {
                            "name": "nota",
                            "label": "Nota",
                            "type": "textarea",
                            "rows": 3,
                            "placeholder": "¿Qué ves?"
                          },
                          {
                            "name": "lugar",
                            "label": "Lugar"
                          }
                        ],
                        "submitLabel": "Guardar en el diario"
                      },
                      "bind": {
                        "modelValue": "$state.draft"
                      },
                      "on": {
                        "update:modelValue": {
                          "set": "draft"
                        },
                        "submit": [
                          {
                            "call": "saveTo",
                            "args": "fotos"
                          },
                          {
                            "set": "draft",
                            "value": {}
                          },
                          {
                            "set": "sent",
                            "value": true
                          }
                        ]
                      }
                    },
                    {
                      "type": "Text",
                      "if": "$errors.saveTo",
                      "bind": {
                        "text": "$errors.saveTo"
                      },
                      "props": {
                        "size": "xs",
                        "tone": "accent"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Panel",
              "if": "$state.sent",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h2",
                        "text": "¡Guardada!"
                      }
                    },
                    {
                      "type": "Stack",
                      "props": {
                        "direction": "row",
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "type": "Button",
                          "props": {
                            "to": "/",
                            "color": "black"
                          },
                          "text": "Ver la galería"
                        },
                        {
                          "type": "Button",
                          "props": {
                            "color": "gray",
                            "variant": "soft"
                          },
                          "text": "Subir otra",
                          "on": {
                            "click": {
                              "set": "sent",
                              "value": false
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
