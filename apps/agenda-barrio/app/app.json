{
  "version": 1,
  "name": "agenda-barrio",
  "title": "Agenda del barrio",
  "description": "Lo que pasa en el barrio: talleres, partidos, asambleas. Cualquiera puede añadir un evento.",
  "lang": "es",
  "theme": {
    "primary": "orange",
    "gray": "stone",
    "colorMode": "light"
  },
  "shell": "shell.json",
  "routes": {
    "/": "agenda.json",
    "/nuevo": "nuevo.json"
  },
  "data": {
    "collections": {
      "eventos": {
        "fields": [
          {
            "name": "titulo",
            "type": "string",
            "required": true
          },
          {
            "name": "categoria",
            "type": "string",
            "required": true
          },
          {
            "name": "fecha",
            "type": "string",
            "required": true
          },
          {
            "name": "lugar",
            "type": "string"
          },
          {
            "name": "descripcion",
            "type": "string"
          }
        ]
      }
    }
  }
}
