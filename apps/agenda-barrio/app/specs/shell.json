{
  "version": 1,
  "children": [
    {
      "type": "Header",
      "props": {
        "z": 20,
        "showMenu": false,
        "showColorMode": false,
        "leftItems": [
          {
            "label": "$t.nav.agenda",
            "to": "/",
            "color": "black"
          },
          {
            "label": "$t.nav.nuevo",
            "to": "/nuevo",
            "color": "black"
          }
        ]
      },
      "children": [
        {
          "slot": "right",
          "type": "Tabs",
          "props": {
            "options": [
              {
                "label": "ES",
                "value": "es"
              },
              {
                "label": "EN",
                "value": "en"
              }
            ]
          },
          "bind": {
            "modelValue": "$locale"
          },
          "on": {
            "update:modelValue": {
              "call": "setLocale"
            }
          }
        }
      ]
    },
    {
      "type": "Outlet"
    }
  ]
}
