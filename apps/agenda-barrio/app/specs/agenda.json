{
  "version": 1,
  "state": {
    "cat": "",
    "search": {},
    "selected": null
  },
  "dataSources": {
    "eventos": {
      "kind": "collection",
      "name": "eventos"
    }
  },
  "children": [
    {
      "type": "div",
      "style": "page-wide",
      "children": [
        {
          "type": "Stack",
          "props": {
            "gap": "lg"
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "row",
                "justify": "between",
                "align": "baseline",
                "wrap": true
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "as": "h1"
                  },
                  "bind": {
                    "text": "$t.agenda.title"
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "to": "/nuevo",
                    "color": "black"
                  },
                  "text": "$t.nav.nuevo"
                }
              ]
            },
            {
              "type": "Tabs",
              "props": {
                "options": [
                  {
                    "label": "$t.agenda.all",
                    "value": ""
                  },
                  {
                    "label": "$t.cat.cultura",
                    "value": "cultura"
                  },
                  {
                    "label": "$t.cat.deporte",
                    "value": "deporte"
                  },
                  {
                    "label": "$t.cat.asamblea",
                    "value": "asamblea"
                  },
                  {
                    "label": "$t.cat.mercado",
                    "value": "mercado"
                  }
                ]
              },
              "bind": {
                "modelValue": "$state.cat"
              },
              "on": {
                "update:modelValue": {
                  "set": "cat"
                }
              }
            },
            {
              "type": "FormFields",
              "props": {
                "fields": [
                  {
                    "name": "q",
                    "type": "text",
                    "placeholder": "$t.agenda.search"
                  }
                ],
                "gap": "gap-0"
              },
              "bind": {
                "modelValue": "$state.search"
              },
              "on": {
                "update:modelValue": {
                  "set": "search"
                }
              }
            },
            {
              "type": "Text",
              "if": "$sources.eventos.error",
              "bind": {
                "text": "$t.agenda.loadError"
              },
              "props": {
                "tone": "accent"
              }
            },
            {
              "type": "List",
              "props": {
                "layout": "grid",
                "cols": 3,
                "gap": "md",
                "filterKey": "categoria",
                "searchKeys": [
                  "titulo",
                  "lugar"
                ],
                "sortBy": "fecha",
                "empty": "$t.agenda.empty"
              },
              "bind": {
                "items": "$data.eventos",
                "filterValue": "$state.cat",
                "search": "$state.search.q"
              },
              "item": {
                "type": "Panel",
                "props": {
                  "variant": "card",
                  "padding": "md"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "gap": "xs"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "bind": {
                          "text": "$item.categoria"
                        },
                        "props": {
                          "size": "xs",
                          "tone": "accent",
                          "weight": "semibold",
                          "labels": {
                            "cultura": "$t.cat.cultura",
                            "deporte": "$t.cat.deporte",
                            "asamblea": "$t.cat.asamblea",
                            "mercado": "$t.cat.mercado"
                          }
                        }
                      },
                      {
                        "type": "Text",
                        "props": {
                          "size": "lg",
                          "weight": "semibold"
                        },
                        "bind": {
                          "text": "$item.titulo"
                        }
                      },
                      {
                        "type": "Stack",
                        "props": {
                          "direction": "row",
                          "gap": "xs"
                        },
                        "children": [
                          {
                            "type": "Text",
                            "bind": {
                              "text": "$item.fecha"
                            },
                            "props": {
                              "size": "sm",
                              "tone": "muted",
                              "format": "date"
                            }
                          },
                          {
                            "type": "Text",
                            "props": {
                              "size": "sm",
                              "tone": "muted",
                              "text": "·"
                            }
                          },
                          {
                            "type": "Text",
                            "props": {
                              "size": "sm",
                              "tone": "muted"
                            },
                            "bind": {
                              "text": "$item.lugar"
                            }
                          }
                        ]
                      },
                      {
                        "type": "Stack",
                        "props": {
                          "direction": "row"
                        },
                        "children": [
                          {
                            "type": "Button",
                            "props": {
                              "color": "gray",
                              "variant": "soft",
                              "size": "xs"
                            },
                            "text": "$t.agenda.details",
                            "on": {
                              "click": {
                                "set": "selected",
                                "value": "$item"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "Modal",
              "if": "$state.selected",
              "props": {
                "modelValue": true,
                "size": "lg",
                "closable": true
              },
              "bind": {
                "title": "$state.selected.titulo"
              },
              "on": {
                "update:modelValue": {
                  "set": "selected",
                  "value": null
                }
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "type": "Stack",
                      "props": {
                        "direction": "row",
                        "gap": "xs"
                      },
                      "children": [
                        {
                          "type": "Text",
                          "bind": {
                            "text": "$state.selected.fecha"
                          },
                          "props": {
                            "size": "sm",
                            "tone": "muted",
                            "format": "date"
                          }
                        },
                        {
                          "type": "Text",
                          "props": {
                            "size": "sm",
                            "tone": "muted",
                            "text": "·"
                          }
                        },
                        {
                          "type": "Text",
                          "props": {
                            "size": "sm",
                            "tone": "muted"
                          },
                          "bind": {
                            "text": "$state.selected.lugar"
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "props": {},
                      "bind": {
                        "text": "$state.selected.descripcion"
                      }
                    },
                    {
                      "type": "Text",
                      "if": "!$state.selected.descripcion",
                      "bind": {
                        "text": "$t.agenda.noDescription"
                      },
                      "props": {
                        "tone": "muted"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
