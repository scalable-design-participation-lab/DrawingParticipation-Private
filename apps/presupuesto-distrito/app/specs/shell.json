{
  "version": 1,
  "children": [
    {
      "type": "Header",
      "props": {
        "z": 30,
        "showMenu": false,
        "showColorMode": true,
        "variant": "text",
        "leftItems": [
          {
            "label": "$t.nav.mapa",
            "to": "/",
            "color": "black"
          },
          {
            "label": "$t.nav.propuestas",
            "to": "/propuestas",
            "color": "black"
          },
          {
            "label": "$t.nav.resultados",
            "to": "/resultados",
            "color": "black"
          },
          {
            "label": "$t.nav.acerca",
            "to": "/acerca",
            "color": "black"
          }
        ]
      },
      "children": [
        {
          "slot": "right",
          "type": "Tabs",
          "props": {
            "options": [
              {
                "label": "ES",
                "value": "es"
              },
              {
                "label": "EN",
                "value": "en"
              }
            ]
          },
          "bind": {
            "modelValue": "$locale"
          },
          "on": {
            "update:modelValue": {
              "call": "setLocale"
            }
          }
        }
      ]
    },
    {
      "type": "Outlet"
    }
  ]
}
