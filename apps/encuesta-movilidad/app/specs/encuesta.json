{
  "version": 1,
  "state": {
    "step": 1,
    "form": {},
    "sent": false
  },
  "children": [
    {
      "type": "div",
      "style": "page-narrow",
      "children": [
        {
          "type": "Stack",
          "props": {
            "gap": "lg"
          },
          "children": [
            {
              "type": "Text",
              "props": {
                "as": "h1",
                "text": "Encuesta de movilidad"
              }
            },
            {
              "type": "Stack",
              "if": "$state.step != 4",
              "props": {
                "direction": "row",
                "gap": "xs",
                "align": "baseline"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "size": "sm",
                    "tone": "muted",
                    "text": "Paso"
                  }
                },
                {
                  "type": "Text",
                  "props": {
                    "size": "sm",
                    "tone": "muted"
                  },
                  "bind": {
                    "text": "$state.step"
                  }
                },
                {
                  "type": "Text",
                  "props": {
                    "size": "sm",
                    "tone": "muted",
                    "text": "de 3"
                  }
                }
              ]
            },
            {
              "type": "Panel",
              "if": "$state.step == 1",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h2",
                        "text": "¿Cómo te mueves normalmente?"
                      }
                    },
                    {
                      "type": "FormFields",
                      "props": {
                        "fields": [
                          {
                            "name": "transporte",
                            "label": "Medio de transporte principal",
                            "type": "select",
                            "placeholder": "Elige una opción",
                            "options": [
                              {
                                "label": "A pie",
                                "value": "pie"
                              },
                              {
                                "label": "Bicicleta",
                                "value": "bici"
                              },
                              {
                                "label": "Transporte público",
                                "value": "publico"
                              },
                              {
                                "label": "Coche",
                                "value": "coche"
                              },
                              {
                                "label": "Moto",
                                "value": "moto"
                              }
                            ]
                          },
                          {
                            "name": "frecuencia",
                            "label": "¿Con qué frecuencia?",
                            "type": "select",
                            "placeholder": "Elige una opción",
                            "options": [
                              {
                                "label": "Todos los días",
                                "value": "diario"
                              },
                              {
                                "label": "Varias veces por semana",
                                "value": "semanal"
                              },
                              {
                                "label": "De vez en cuando",
                                "value": "ocasional"
                              }
                            ]
                          }
                        ]
                      },
                      "bind": {
                        "modelValue": "$state.form"
                      },
                      "on": {
                        "update:modelValue": {
                          "set": "form"
                        }
                      }
                    },
                    {
                      "type": "Text",
                      "if": "!$state.form.transporte",
                      "props": {
                        "size": "xs",
                        "tone": "muted",
                        "text": "Elige un medio de transporte para continuar."
                      }
                    },
                    {
                      "type": "div",
                      "if": "$state.form.transporte",
                      "children": [
                        {
                          "type": "Stack",
                          "props": {
                            "direction": "row",
                            "justify": "between"
                          },
                          "children": [
                            {
                              "type": "span"
                            },
                            {
                              "type": "Button",
                              "props": {
                                "color": "black"
                              },
                              "text": "Siguiente",
                              "on": {
                                "click": {
                                  "set": "step",
                                  "value": 2
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Panel",
              "if": "$state.step == 2",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h2",
                        "text": "¿Cuánto tardas?"
                      }
                    },
                    {
                      "type": "FormFields",
                      "props": {
                        "fields": [
                          {
                            "name": "minutos",
                            "label": "Minutos de ida, en un día normal",
                            "type": "number",
                            "placeholder": "30"
                          }
                        ]
                      },
                      "bind": {
                        "modelValue": "$state.form"
                      },
                      "on": {
                        "update:modelValue": {
                          "set": "form"
                        }
                      }
                    },
                    {
                      "type": "Stack",
                      "props": {
                        "direction": "row",
                        "justify": "between"
                      },
                      "children": [
                        {
                          "type": "Button",
                          "props": {
                            "color": "gray",
                            "variant": "soft"
                          },
                          "text": "Atrás",
                          "on": {
                            "click": {
                              "set": "step",
                              "value": 1
                            }
                          }
                        },
                        {
                          "type": "Button",
                          "props": {
                            "color": "black"
                          },
                          "text": "Siguiente",
                          "on": {
                            "click": {
                              "set": "step",
                              "value": 3
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Panel",
              "if": "$state.step == 3",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h2",
                        "text": "¿Algo más?"
                      }
                    },
                    {
                      "type": "FormFields",
                      "props": {
                        "fields": [
                          {
                            "name": "comentario",
                            "label": "¿Qué mejorarías de tu trayecto?",
                            "type": "textarea",
                            "rows": 4
                          }
                        ],
                        "submitLabel": "Enviar respuestas"
                      },
                      "bind": {
                        "modelValue": "$state.form"
                      },
                      "on": {
                        "update:modelValue": {
                          "set": "form"
                        },
                        "submit": [
                          {
                            "call": "saveTo",
                            "args": "respuestas"
                          },
                          {
                            "set": "sent",
                            "value": true
                          },
                          {
                            "set": "step",
                            "value": 4
                          }
                        ]
                      }
                    },
                    {
                      "type": "Text",
                      "if": "$errors.saveTo",
                      "bind": {
                        "text": "$errors.saveTo"
                      },
                      "props": {
                        "size": "xs",
                        "tone": "accent"
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "color": "gray",
                        "variant": "soft"
                      },
                      "text": "Atrás",
                      "on": {
                        "click": {
                          "set": "step",
                          "value": 2
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Panel",
              "if": "$state.step == 4",
              "props": {
                "variant": "card",
                "padding": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "md"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h2",
                        "text": "¡Gracias por responder!"
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "Tus respuestas ya cuentan en los resultados."
                      }
                    },
                    {
                      "type": "Stack",
                      "props": {
                        "direction": "row",
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "type": "Button",
                          "props": {
                            "to": "/resultados",
                            "color": "black"
                          },
                          "text": "Ver resultados"
                        },
                        {
                          "type": "Button",
                          "props": {
                            "color": "gray",
                            "variant": "soft"
                          },
                          "text": "Responder otra vez",
                          "on": {
                            "click": [
                              {
                                "set": "form",
                                "value": {}
                              },
                              {
                                "set": "sent",
                                "value": false
                              },
                              {
                                "set": "step",
                                "value": 1
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
