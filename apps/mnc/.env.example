# MNC app environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Firebase ---
# Read by the `nuxt-vuefire` module in nuxt.config.ts (vuefire.config).
# Find these in Firebase console > Project settings > Your apps > SDK setup.
# The Storage bucket is required for image uploads (contributions store).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Mapbox ---
# Public token used by the base map (exposed via runtimeConfig.public).
MAPBOX_ACCESS_TOKEN=
