{
  "version": 1,
  "state": {
    "loading": true,
    "mapType": "vector",
    "isMobile": false,
    "features": [],
    "visibleTags": [
      "Health & Crisis Response",
      "Transportation & Mobility",
      "Digital Access & Connectivity",
      "Community Mapping & Visibility",
      "Art & Cultural Expression"
    ],
    "selected": null,
    "quickLook": false,
    "detail": false,
    "panelOpen": false,
    "listOpen": false,
    "onboarding": true,
    "mobileView": "map",
    "cardState": "expanded",
    "contribute": false,
    "picking": false,
    "pin": null,
    "contributions": [],
    "contributionsLoading": false,
    "auth": {
      "ready": false,
      "isAdmin": false,
      "isSuperAdmin": false,
      "isAnonymous": true,
      "uid": null,
      "email": null
    },
    "moderation": [],
    "pendingContributions": [],
    "loginOpen": false,
    "reviewOpen": false,
    "login": {},
    "mode": "map"
  },
  "init": [
    {
      "call": "watchViewport"
    },
    {
      "call": "watchAuth"
    },
    {
      "call": "loadCatalog"
    },
    {
      "set": "loading",
      "value": false
    },
    {
      "call": "watchSolutions"
    }
  ],
  "children": [
    {
      "type": "LoadingScreen",
      "if": "$state.loading",
      "props": {
        "title": "$t.loading.title",
        "message": "$t.loading.message",
        "steps": [
          "$t.loading.steps.0",
          "$t.loading.steps.1",
          "$t.loading.steps.2",
          "$t.loading.steps.3"
        ]
      }
    },
    {
      "type": "div",
      "style": "page-shell",
      "if": "!$state.loading",
      "children": [
        {
          "type": "MncMap",
          "bind": {
            "features": "$state.features",
            "visibleTags": "$state.visibleTags",
            "selected": "$state.selected",
            "quickLook": "$state.quickLook",
            "picking": "$state.picking",
            "pin": "$state.pin",
            "mapType": "$state.mapType",
            "isMobile": "$state.isMobile"
          },
          "on": {
            "update:selected": [
              {
                "set": "selected"
              },
              {
                "set": "cardState",
                "value": "expanded"
              },
              {
                "call": "loadContributions",
                "args": "$state.selected.properties.string_id"
              }
            ],
            "update:quickLook": {
              "set": "quickLook"
            },
            "expand": [
              {
                "set": "detail",
                "value": true
              },
              {
                "set": "quickLook",
                "value": false
              }
            ],
            "pick": [
              {
                "set": "pin"
              },
              {
                "set": "picking",
                "value": false
              }
            ],
            "addAt": [
              {
                "set": "pin"
              },
              {
                "set": "contribute",
                "value": true
              }
            ]
          }
        },
        {
          "type": "div",
          "if": "!$state.isMobile",
          "children": [
            {
              "type": "Header",
              "props": {
                "showMenu": false,
                "leftItems": [
                  {
                    "label": "MNC",
                    "to": "https://mobilecreativity.net",
                    "target": "_blank"
                  }
                ]
              },
              "children": [
                {
                  "slot": "right",
                  "type": "Tabs",
                  "props": {
                    "options": [
                      {
                        "label": "EN",
                        "value": "en"
                      },
                      {
                        "label": "PT",
                        "value": "pt"
                      },
                      {
                        "label": "ES",
                        "value": "es"
                      }
                    ]
                  },
                  "bind": {
                    "modelValue": "$locale"
                  },
                  "on": {
                    "update:modelValue": {
                      "call": "setLocale"
                    }
                  }
                },
                {
                  "slot": "right",
                  "type": "MapTypeToggle",
                  "bind": {
                    "modelValue": "$state.mapType"
                  },
                  "on": {
                    "update:modelValue": {
                      "set": "mapType"
                    }
                  }
                }
              ]
            },
            {
              "type": "IconBar",
              "if": "!$state.contribute",
              "props": {
                "position": "top",
                "multiple": true,
                "field": "primaryTag",
                "first": [
                  "Health & Crisis Response",
                  "Transportation & Mobility",
                  "Digital Access & Connectivity",
                  "Community Mapping & Visibility",
                  "Art & Cultural Expression"
                ],
                "exclude": [
                  "Uncategorized"
                ],
                "icons": {
                  "Health & Crisis Response": "i-heroicons-heart",
                  "Transportation & Mobility": "i-ph-bus",
                  "Digital Access & Connectivity": "i-heroicons-wifi",
                  "Community Mapping & Visibility": "i-heroicons-user-group",
                  "Art & Cultural Expression": "i-heroicons-light-bulb"
                },
                "colors": {
                  "Health & Crisis Response": "#F26D6D",
                  "Transportation & Mobility": "#4C9BEA",
                  "Digital Access & Connectivity": "#57C9C0",
                  "Community Mapping & Visibility": "#6FCF97",
                  "Art & Cultural Expression": "#EBC24A"
                }
              },
              "bind": {
                "rows": "$state.features",
                "modelValue": "$state.visibleTags"
              },
              "on": {
                "update:modelValue": {
                  "set": "visibleTags"
                }
              }
            },
            {
              "type": "IconBar",
              "if": "!$state.onboarding && !$state.contribute && !$state.detail && !$state.selected",
              "props": {
                "position": "bottom",
                "size": "lg",
                "items": [
                  {
                    "value": "map",
                    "icon": "i-heroicons-map",
                    "label": "$t.nav.map",
                    "color": "#57C9C0",
                    "onClick": {
                      "$action": [
                        {
                          "set": "panelOpen",
                          "value": false
                        },
                        {
                          "set": "listOpen",
                          "value": false
                        }
                      ]
                    }
                  },
                  {
                    "value": "list",
                    "icon": "i-heroicons-square-3-stack-3d",
                    "label": "$t.nav.list",
                    "color": "#57C9C0",
                    "onClick": {
                      "$action": [
                        {
                          "set": "listOpen",
                          "value": true
                        },
                        {
                          "set": "panelOpen",
                          "value": false
                        }
                      ]
                    }
                  },
                  {
                    "value": "info",
                    "icon": "i-heroicons-information-circle",
                    "label": "$t.nav.info",
                    "color": "#57C9C0",
                    "onClick": {
                      "$action": [
                        {
                          "set": "onboarding",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "value": "add",
                    "icon": "i-heroicons-plus",
                    "label": "$t.nav.addEntry",
                    "color": "#57C9C0",
                    "onClick": {
                      "$action": [
                        {
                          "set": "contribute",
                          "value": true
                        },
                        {
                          "set": "picking",
                          "value": false
                        },
                        {
                          "set": "pin",
                          "value": null
                        }
                      ]
                    }
                  }
                ]
              },
              "bind": {
                "modelValue": "$state.mode"
              },
              "on": {
                "update:modelValue": {
                  "set": "mode"
                }
              }
            },
            {
              "type": "MobileContributeFlow",
              "bind": {
                "pickedCoordinate": "$state.pin"
              },
              "on": {
                "pickLocation": {
                  "set": "picking",
                  "value": true
                },
                "close": [
                  {
                    "set": "contribute",
                    "value": false
                  },
                  {
                    "set": "picking",
                    "value": false
                  },
                  {
                    "set": "pin",
                    "value": null
                  }
                ],
                "submit": {
                  "call": "submitEntry"
                }
              },
              "if": "$state.contribute && !$state.picking"
            },
            {
              "type": "FilteredSelectionSidebar",
              "if": "$state.panelOpen",
              "bind": {
                "features": "$state.features",
                "visibleTags": "$state.visibleTags"
              },
              "on": {
                "select": [
                  {
                    "set": "selected"
                  },
                  {
                    "call": "loadContributions",
                    "args": "$state.selected.properties.string_id"
                  }
                ],
                "toggleTag": {
                  "call": "toggleItem",
                  "args": "visibleTags"
                }
              }
            },
            {
              "type": "ProjectListPanel",
              "if": "$state.listOpen",
              "bind": {
                "features": "$state.features",
                "visibleTags": "$state.visibleTags"
              },
              "on": {
                "select": [
                  {
                    "set": "selected"
                  },
                  {
                    "set": "listOpen",
                    "value": false
                  },
                  {
                    "call": "loadContributions",
                    "args": "$state.selected.properties.string_id"
                  }
                ],
                "close": {
                  "set": "listOpen",
                  "value": false
                }
              }
            },
            {
              "type": "EntryDetail",
              "if": "$state.detail && $state.selected",
              "bind": {
                "entry": "$state.selected",
                "contributions": "$state.contributions",
                "loading": "$state.contributionsLoading",
                "isAdmin": "$state.auth.isAdmin"
              },
              "on": {
                "close": [
                  {
                    "set": "detail",
                    "value": false
                  },
                  {
                    "set": "selected",
                    "value": null
                  }
                ],
                "showTag": [
                  {
                    "set": "visibleTags",
                    "value": [
                      "$payload"
                    ]
                  },
                  {
                    "set": "listOpen",
                    "value": true
                  },
                  {
                    "set": "panelOpen",
                    "value": false
                  },
                  {
                    "set": "detail",
                    "value": false
                  },
                  {
                    "set": "selected",
                    "value": null
                  }
                ],
                "contribute": {
                  "call": "addContribution"
                },
                "approve": {
                  "call": "approveContribution"
                },
                "delete": {
                  "call": "deleteContribution"
                }
              }
            }
          ]
        },
        {
          "type": "div",
          "if": "$state.isMobile",
          "children": [
            {
              "type": "MobileHeader",
              "if": "!$state.onboarding && $state.mobileView != 'more'",
              "bind": {
                "mapType": "$state.mapType"
              },
              "on": {
                "update:mapType": {
                  "set": "mapType"
                }
              }
            },
            {
              "type": "MobileProximityList",
              "if": "$state.mobileView == 'list'",
              "bind": {
                "features": "$state.features"
              },
              "on": {
                "select": [
                  {
                    "set": "selected"
                  },
                  {
                    "set": "mobileView",
                    "value": "map"
                  },
                  {
                    "set": "cardState",
                    "value": "expanded"
                  },
                  {
                    "call": "loadContributions",
                    "args": "$state.selected.properties.string_id"
                  }
                ]
              }
            },
            {
              "type": "MobileInfoPopup",
              "if": "$state.selected",
              "bind": {
                "entry": "$state.selected",
                "state": "$state.cardState",
                "contributions": "$state.contributions",
                "isAdmin": "$state.auth.isAdmin"
              },
              "on": {
                "close": {
                  "set": "selected",
                  "value": null
                },
                "update:state": {
                  "set": "cardState"
                },
                "contribute": {
                  "call": "addContribution"
                },
                "approve": {
                  "call": "approveContribution"
                },
                "delete": {
                  "call": "deleteContribution"
                }
              }
            },
            {
              "type": "IconBar",
              "if": "!$state.onboarding && !$state.selected && $state.mobileView != 'more' && $state.mobileView != 'info'",
              "props": {
                "position": "bottom",
                "size": "lg",
                "items": [
                  {
                    "value": "map",
                    "icon": "i-heroicons-map",
                    "label": "$t.nav.map",
                    "color": "#57C9C0"
                  },
                  {
                    "value": "list",
                    "icon": "i-heroicons-square-3-stack-3d",
                    "label": "$t.nav.list",
                    "color": "#57C9C0"
                  },
                  {
                    "value": "info",
                    "icon": "i-heroicons-information-circle",
                    "label": "$t.nav.info",
                    "color": "#57C9C0"
                  },
                  {
                    "value": "more",
                    "icon": "i-heroicons-plus",
                    "label": "$t.nav.addEntryMobile",
                    "color": "#57C9C0"
                  }
                ]
              },
              "bind": {
                "modelValue": "$state.mobileView"
              },
              "on": {
                "update:modelValue": {
                  "set": "mobileView"
                }
              }
            },
            {
              "type": "MobileContributeFlow",
              "bind": {
                "pickedCoordinate": "$state.pin"
              },
              "on": {
                "pickLocation": {
                  "set": "picking",
                  "value": true
                },
                "close": [
                  {
                    "set": "mobileView",
                    "value": "map"
                  },
                  {
                    "set": "picking",
                    "value": false
                  },
                  {
                    "set": "pin",
                    "value": null
                  }
                ],
                "submit": {
                  "call": "submitEntry"
                }
              },
              "if": "$state.mobileView == 'more' && !$state.picking"
            },
            {
              "type": "Modal",
              "if": "$state.mobileView == 'info'",
              "props": {
                "title": "$t.onboarding.title",
                "align": "center",
                "size": "lg",
                "buttonLabel": "$t.onboarding.getStarted"
              },
              "on": {
                "confirm": {
                  "set": "mobileView",
                  "value": "map"
                },
                "close": {
                  "set": "mobileView",
                  "value": "map"
                }
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "gap": "lg"
                  },
                  "children": [
                    {
                      "type": "Stack",
                      "props": {
                        "direction": "row",
                        "justify": "end"
                      },
                      "children": [
                        {
                          "type": "Tabs",
                          "props": {
                            "options": [
                              {
                                "label": "EN",
                                "value": "en"
                              },
                              {
                                "label": "PT",
                                "value": "pt"
                              },
                              {
                                "label": "ES",
                                "value": "es"
                              }
                            ]
                          },
                          "bind": {
                            "modelValue": "$locale"
                          },
                          "on": {
                            "update:modelValue": {
                              "call": "setLocale"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "Text",
                      "props": {
                        "text": "$t.onboarding.intro"
                      }
                    },
                    {
                      "type": "Stack",
                      "props": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "type": "Stack",
                          "props": {
                            "direction": "row",
                            "gap": "sm",
                            "align": "start"
                          },
                          "children": [
                            {
                              "type": "Icon",
                              "props": {
                                "name": "i-heroicons-map",
                                "size": "lg",
                                "tone": "accent"
                              }
                            },
                            {
                              "type": "Text",
                              "props": {
                                "text": "$t.onboarding.point1"
                              }
                            }
                          ]
                        },
                        {
                          "type": "Stack",
                          "props": {
                            "direction": "row",
                            "gap": "sm",
                            "align": "start"
                          },
                          "children": [
                            {
                              "type": "Icon",
                              "props": {
                                "name": "i-heroicons-cursor-arrow-rays",
                                "size": "lg",
                                "tone": "accent"
                              }
                            },
                            {
                              "type": "Text",
                              "props": {
                                "text": "$t.onboarding.point2"
                              }
                            }
                          ]
                        },
                        {
                          "type": "Stack",
                          "props": {
                            "direction": "row",
                            "gap": "sm",
                            "align": "start"
                          },
                          "children": [
                            {
                              "type": "Icon",
                              "props": {
                                "name": "i-heroicons-camera",
                                "size": "lg",
                                "tone": "accent"
                              }
                            },
                            {
                              "type": "Text",
                              "props": {
                                "text": "$t.onboarding.point3"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "slot": "footer",
                  "type": "Text",
                  "props": {
                    "text": "$t.onboarding.footer",
                    "size": "xs",
                    "tone": "muted",
                    "align": "center"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "div",
          "style": "pick-banner",
          "if": "$state.picking",
          "children": [
            {
              "type": "Icon",
              "props": {
                "name": "i-heroicons-map-pin"
              },
              "style": "pick-icon"
            },
            {
              "type": "Text",
              "bind": {
                "text": "$t.add.pickBanner"
              },
              "props": {
                "size": "sm",
                "weight": "medium"
              }
            }
          ]
        },
        {
          "type": "div",
          "style": "moderate-trigger",
          "if": "$state.mobileView == 'map'",
          "children": [
            {
              "type": "Button",
              "if": "!$state.auth.isAdmin",
              "props": {
                "icon": "i-heroicons-lock-closed",
                "color": "gray",
                "variant": "solid",
                "size": "sm"
              },
              "style": "round-shadow",
              "on": {
                "click": {
                  "set": "loginOpen",
                  "value": true
                }
              }
            },
            {
              "type": "Button",
              "if": "$state.auth.isAdmin",
              "props": {
                "icon": "i-heroicons-shield-check",
                "color": "gray",
                "variant": "solid",
                "size": "sm"
              },
              "style": "round-shadow",
              "text": "$t.mod.moderate",
              "on": {
                "click": {
                  "toggle": "reviewOpen"
                }
              }
            }
          ]
        },
        {
          "type": "Modal",
          "props": {
            "size": "sm"
          },
          "bind": {
            "modelValue": "$state.loginOpen",
            "title": "$t.mod.signInTitle"
          },
          "on": {
            "update:modelValue": {
              "set": "loginOpen"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "sm"
              },
              "children": [
                {
                  "type": "FormFields",
                  "props": {
                    "fields": [
                      {
                        "name": "email",
                        "type": "email",
                        "placeholder": "Email"
                      },
                      {
                        "name": "password",
                        "type": "password",
                        "placeholder": "Password"
                      }
                    ],
                    "submitLabel": "Sign in",
                    "gap": "gap-3"
                  },
                  "bind": {
                    "modelValue": "$state.login"
                  },
                  "on": {
                    "update:modelValue": {
                      "set": "login"
                    },
                    "submit": [
                      {
                        "call": "signInModerator"
                      },
                      {
                        "set": "loginOpen",
                        "value": false
                      },
                      {
                        "set": "login",
                        "value": {}
                      },
                      {
                        "set": "reviewOpen",
                        "value": true
                      }
                    ]
                  }
                },
                {
                  "type": "Text",
                  "if": "$errors.signInModerator",
                  "bind": {
                    "text": "$errors.signInModerator"
                  },
                  "props": {
                    "size": "xs",
                    "tone": "accent"
                  }
                },
                {
                  "type": "Text",
                  "if": "$errors.resetPassword",
                  "bind": {
                    "text": "$errors.resetPassword"
                  },
                  "props": {
                    "size": "xs",
                    "tone": "accent"
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "variant": "link",
                    "color": "gray",
                    "size": "xs"
                  },
                  "text": "$t.mod.forgotPassword",
                  "on": {
                    "click": {
                      "call": "resetPassword",
                      "args": "$state.login.email"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "ModerationPanel",
          "if": "$state.auth.isAdmin && $state.reviewOpen",
          "bind": {
            "moderation": "$state.moderation",
            "pending": "$state.pendingContributions",
            "features": "$state.features",
            "isSuperAdmin": "$state.auth.isSuperAdmin"
          },
          "on": {
            "approveEntry": {
              "call": "approveEntry"
            },
            "deleteEntry": {
              "call": "deleteEntry"
            },
            "approveContribution": {
              "call": "approveContribution"
            },
            "deleteContribution": {
              "call": "deleteContribution"
            },
            "flyTo": [
              {
                "call": "selectItem",
                "args": {
                  "from": "features",
                  "into": "selected",
                  "key": "properties.string_id"
                }
              },
              {
                "call": "loadContributions",
                "args": "$state.selected.properties.string_id"
              }
            ],
            "signOut": [
              {
                "call": "signOut"
              },
              {
                "set": "reviewOpen",
                "value": false
              }
            ],
            "close": {
              "set": "reviewOpen",
              "value": false
            }
          }
        },
        {
          "type": "Modal",
          "props": {
            "title": "$t.onboarding.title",
            "align": "center",
            "size": "lg",
            "buttonLabel": "$t.onboarding.getStarted"
          },
          "bind": {
            "modelValue": "$state.onboarding"
          },
          "on": {
            "confirm": {
              "set": "onboarding",
              "value": false
            },
            "close": {
              "set": "onboarding",
              "value": false
            },
            "update:modelValue": {
              "set": "onboarding"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "lg"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "justify": "end"
                  },
                  "children": [
                    {
                      "type": "Tabs",
                      "props": {
                        "options": [
                          {
                            "label": "EN",
                            "value": "en"
                          },
                          {
                            "label": "PT",
                            "value": "pt"
                          },
                          {
                            "label": "ES",
                            "value": "es"
                          }
                        ]
                      },
                      "bind": {
                        "modelValue": "$locale"
                      },
                      "on": {
                        "update:modelValue": {
                          "call": "setLocale"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "$t.onboarding.intro"
                  }
                },
                {
                  "type": "Stack",
                  "props": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "type": "Stack",
