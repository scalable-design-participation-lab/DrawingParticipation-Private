{
  "version": 1,
  "state": {
    "loading": true,
    "mapType": "vector",
    "menuOpen": false,
    "supportOpen": false,
    "showDownload": false,
    "onboarding": true,
    "registration": false,
    "needsRegistration": true
  },
  "children": [
    {
      "type": "LoadingScreen",
      "if": "$state.loading",
      "on": {
        "done": {
          "set": "loading",
          "value": false
        }
      }
    },
    {
      "type": "SideBar"
    },
    {
      "type": "RuMap",
      "props": {
        "showAllPlusIcons": true,
        "showCommentIcons": false
      },
      "bind": {
        "mapType": "$state.mapType",
        "blurred": "$state.needsRegistration"
      }
    },
    {
      "type": "Header",
      "props": {
        "z": 20,
        "logoSrc": "/restart-logo-icon.svg",
        "logoAlt": "Restart Agency Logo",
        "logoLink": "https://www.restartfuture.org/",
        "leftItems": [
          {
            "label": "Drawing Participation",
            "color": "black",
            "to": "/about/"
          },
          {
            "label": "Гуртомá",
            "color": "black",
            "to": "/about/"
          }
        ],
        "rightItems": [
          {
            "icon": "i-heroicons-arrow-down-tray-20-solid",
            "onClick": {
              "$action": {
                "set": "showDownload",
                "value": true
              }
            }
          }
        ]
      },
      "on": {
        "menu": {
          "set": "menuOpen",
          "value": true
        }
      },
      "children": [
        {
          "slot": "right",
          "type": "MapTypeToggle",
          "bind": {
            "modelValue": "$state.mapType"
          },
          "on": {
            "update:modelValue": {
              "set": "mapType"
            }
          }
        }
      ]
    },
    {
      "type": "Modal",
      "props": {
        "size": "sm"
      },
      "bind": {
        "modelValue": "$state.menuOpen"
      },
      "on": {
        "update:modelValue": {
          "set": "menuOpen"
        }
      },
      "children": [
        {
          "type": "Stack",
          "props": {
            "direction": "column",
            "gap": "sm"
          },
          "children": [
            {
              "type": "Button",
              "props": {
                "block": true,
                "color": "white",
                "variant": "solid",
                "to": "/"
              },
              "style": "menu-item",
              "text": "Головна",
              "on": {
                "click": [
                  {
                    "set": "menuOpen",
                    "value": false
                  }
                ]
              }
            },
            {
              "type": "Button",
              "props": {
                "block": true,
                "color": "white",
                "variant": "solid",
                "to": "/about"
              },
              "style": "menu-item",
              "text": "Про нас",
              "on": {
                "click": [
                  {
                    "set": "menuOpen",
                    "value": false
                  }
                ]
              }
            },
            {
              "type": "Button",
              "props": {
                "block": true,
                "color": "white",
                "variant": "solid"
              },
              "style": "menu-item",
              "text": "Підтримка",
              "on": {
                "click": [
                  {
                    "set": "menuOpen",
                    "value": false
                  },
                  {
                    "set": "supportOpen",
                    "value": true
                  }
                ]
              }
            },
            {
              "type": "Button",
              "props": {
                "block": true,
                "color": "white",
                "variant": "solid",
                "to": "/result"
              },
              "style": "menu-item",
              "text": "Результати",
              "on": {
                "click": [
                  {
                    "set": "menuOpen",
                    "value": false
                  }
                ]
              }
            },
            {
              "type": "Button",
              "props": {
                "block": true,
                "color": "white",
                "variant": "solid",
                "to": "/dashboard"
              },
              "style": "menu-item",
              "text": "приладова панель",
              "on": {
                "click": [
                  {
                    "set": "menuOpen",
                    "value": false
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Footer",
      "on": {
        "support": {
          "set": "supportOpen",
          "value": true
        }
      }
    },
    {
      "type": "Modal",
      "props": {
        "title": "Допомога",
        "size": "lg",
        "closable": true,
        "buttonLabel": "Повернутися до карти"
      },
      "bind": {
        "modelValue": "$state.supportOpen"
      },
      "on": {
        "update:modelValue": {
          "set": "supportOpen"
        }
      },
      "children": [
        {
          "type": "Stack",
          "props": {
            "gap": "md"
          },
          "children": [
            {
              "type": "Text",
              "props": {
                "text": "«Гуртомá» — проєкт зі спільного створення мапи завдяки містянам, який дозволяє дослідити питання використання й ставлення до навколишнього простору."
              }
            },
            {
              "type": "Stack",
              "props": {
                "gap": "xs"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "as": "h3",
                    "size": "md",
                    "weight": "medium",
                    "text": "Ключові особливості:"
                  }
                },
                {
                  "type": "ul",
                  "style": "bullets",
                  "children": [
                    {
                      "type": "li",
                      "text": "Малюйте та позначайте місця, які ви відвідуєте та використовуєте для певної мети"
                    },
                    {
                      "type": "li",
                      "text": "Діліться своїм досвідом про відчуття безпеки та єдності"
                    },
                    {
                      "type": "li",
                      "text": "Робіть внесок у захист довкілля"
                    },
                    {
                      "type": "li",
                      "text": "Знайомтесь з думкою спільноти"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Text",
              "props": {
                "text": "Як долучитися: Використовуйте інструменти на лівій панелі збоку, щоб позначати місця та ділитися своїм досвідом. Ваш внесок дозволить краще зрозуміти, в якому стані міський простір та як його покращити."
              }
            },
            {
              "type": "Text",
              "children": [
                {
                  "type": "span",
                  "text": "Будь ласка, "
                },
                {
                  "type": "a",
                  "props": {
                    "href": "https://forms.gle/6d8GuBSPaingSR4L6",
                    "target": "_blank"
                  },
                  "style": "link",
                  "text": "заповніть форму"
                },
                {
                  "type": "span",
                  "text": ", якщо бажаєте залишити відгук про платформу."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Modal",
      "props": {
        "title": "Ласкаво просимо до Гуртома́!",
        "align": "center",
        "size": "md"
      },
      "bind": {
        "modelValue": "$state.onboarding"
      },
      "on": {
        "update:modelValue": {
          "set": "onboarding"
        }
      },
      "children": [
        {
          "type": "Stack",
          "props": {
            "gap": "lg"
          },
          "children": [
            {
              "type": "Text",
              "props": {
                "align": "center",
                "text": "Гуртома́ — платформа, яка допомагає змінювати українські міста на краще."
              }
            },
            {
              "type": "Stack",
              "props": {
                "gap": "sm"
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "type": "Icon",
                      "props": {
                        "name": "i-heroicons-map"
                      },
                      "style": "feature-icon"
                    },
                    {
                      "type": "Text",
                      "props": {
                        "align": "left",
                        "text": "Досліджуйте мапу та діліться думкою про місця навколо річки Тяжилівка"
                      }
                    }
                  ]
                },
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "type": "Icon",
                      "props": {
                        "name": "i-heroicons-chat-bubble-left-right"
                      },
                      "style": "feature-icon"
                    },
                    {
                      "type": "Text",
                      "props": {
                        "align": "left",
                        "text": "Беріть участь в обговореннях з іншими користувачами"
                      }
                    }
                  ]
                },
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "type": "Icon",
                      "props": {
                        "name": "i-heroicons-camera"
                      },
                      "style": "feature-icon"
                    },
                    {
                      "type": "Text",
                      "props": {
                        "align": "left",
                        "text": "Додавайте коментарі, щоб поділитися спогадами та ідеями для покращення річки"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Stack",
              "props": {
                "direction": "row",
                "justify": "center"
              },
              "children": [
                {
                  "type": "Button",
                  "props": {
                    "color": "black"
                  },
                  "style": "pill-button",
                  "text": "Розпочати реєстрацію",
                  "on": {
                    "click": [
                      {
                        "set": "onboarding",
                        "value": false
                      },
                      {
                        "set": "registration",
                        "value": true
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "Text",
              "props": {
                "size": "xs",
                "tone": "muted",
                "align": "center"
              },
              "children": [
                {
                  "type": "span",
                  "text": "Гуртомá – це спільний проєкт "
                },
                {
                  "type": "a",
                  "props": {
                    "href": "https://www.restartfuture.org/",
                    "target": "_blank"
                  },
                  "style": "link",
                  "text": "Restart"
                },
                {
                  "type": "span",
                  "text": " та "
                },
                {
                  "type": "a",
                  "props": {
                    "href": "https://northeastern.edu",
                    "target": "_blank"
                  },
                  "style": "link",
                  "text": "Northeastern University"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "RegistrationModal",
      "bind": {
        "isVisible": "$state.registration"
      },
      "on": {
        "close": {
          "set": "registration",
          "value": false
        },
        "registered": {
          "set": "needsRegistration",
          "value": false
        }
      }
    },
    {
      "type": "div",
      "if": "$state.needsRegistration",
      "style": "overlay",
      "on": {
        "click": {
          "set": "registration",
          "value": true
        }
      }
    },
    {
      "type": "Modal",
      "props": {
        "title": "Доступ до відкритих даних",
        "align": "center",
        "size": "md",
        "buttonLabel": "Повернутися до карти",
        "text": "Ми працюємо над тим, щоб дані, створені на платформі, стали відкритими та доступними для всіх. Повертайтеся незабаром, щоб перевірити оновлення."
      },
      "bind": {
        "modelValue": "$state.showDownload"
      },
      "on": {
        "update:modelValue": {
          "set": "showDownload"
        }
      }
    }
  ]
}
