{
  "version": 1,
  "state": {
    "mapType": "vector",
    "menuOpen": false,
    "supportOpen": false,
    "showIntro": "$query.showIntro"
  },
  "children": [
    {
      "type": "div",
      "style": "screen",
      "children": [
        {
          "type": "Header",
          "props": {
            "z": 20,
            "logoSrc": "/restart-logo-icon.svg",
            "logoAlt": "Restart Agency Logo",
            "logoLink": "https://www.restartfuture.org/",
            "leftItems": [
              {
                "label": "Drawing Participation",
                "variant": "solid",
                "color": "black"
              },
              {
                "label": "Гуртомá",
                "variant": "solid",
                "color": "black"
              }
            ]
          },
          "on": {
            "menu": {
              "set": "menuOpen",
              "value": true
            }
          },
          "children": [
            {
              "slot": "right",
              "type": "MapTypeToggle",
              "bind": {
                "modelValue": "$state.mapType"
              },
              "on": {
                "update:modelValue": {
                  "set": "mapType"
                }
              }
            }
          ]
        },
        {
          "type": "Modal",
          "props": {
            "size": "sm"
          },
          "bind": {
            "modelValue": "$state.menuOpen"
          },
          "on": {
            "update:modelValue": {
              "set": "menuOpen"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "column",
                "gap": "sm"
              },
              "children": [
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/"
                  },
                  "style": "menu-item",
                  "text": "Головна",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/about"
                  },
                  "style": "menu-item",
                  "text": "Про нас",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid"
                  },
                  "style": "menu-item",
                  "text": "Підтримка",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      },
                      {
                        "set": "supportOpen",
                        "value": true
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/result"
                  },
                  "style": "menu-item",
                  "text": "Результати",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/dashboard"
                  },
                  "style": "menu-item",
                  "text": "приладова панель",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "div",
          "style": "map-layer",
          "children": [
            {
              "type": "RuMap",
              "props": {
                "showAllPlusIcons": false,
                "showCommentIcons": true
              },
              "bind": {
                "mapType": "$state.mapType"
              }
            }
          ]
        },
        {
          "type": "Footer",
          "on": {
            "support": {
              "set": "supportOpen",
              "value": true
            }
          }
        },
        {
          "type": "Modal",
          "props": {
            "title": "Допомога",
            "size": "lg",
            "closable": true,
            "buttonLabel": "Повернутися до карти"
          },
          "bind": {
            "modelValue": "$state.supportOpen"
          },
          "on": {
            "update:modelValue": {
              "set": "supportOpen"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "md"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "«Гуртомá» — проєкт зі спільного створення мапи завдяки містянам, який дозволяє дослідити питання використання й ставлення до навколишнього простору."
                  }
                },
                {
                  "type": "Stack",
                  "props": {
                    "gap": "xs"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h3",
                        "size": "md",
                        "weight": "medium",
                        "text": "Ключові особливості:"
                      }
                    },
                    {
                      "type": "ul",
                      "style": "bullets",
                      "children": [
                        {
                          "type": "li",
                          "text": "Малюйте та позначайте місця, які ви відвідуєте та використовуєте для певної мети"
                        },
                        {
                          "type": "li",
                          "text": "Діліться своїм досвідом про відчуття безпеки та єдності"
                        },
                        {
                          "type": "li",
                          "text": "Робіть внесок у захист довкілля"
                        },
                        {
                          "type": "li",
                          "text": "Знайомтесь з думкою спільноти"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Як долучитися: Використовуйте інструменти на лівій панелі збоку, щоб позначати місця та ділитися своїм досвідом. Ваш внесок дозволить краще зрозуміти, в якому стані міський простір та як його покращити."
                  }
                },
                {
                  "type": "Text",
                  "children": [
                    {
                      "type": "span",
                      "text": "Будь ласка, "
                    },
                    {
                      "type": "a",
                      "props": {
                        "href": "https://forms.gle/6d8GuBSPaingSR4L6",
                        "target": "_blank"
                      },
                      "style": "link",
                      "text": "заповніть форму"
                    },
                    {
                      "type": "span",
                      "text": ", якщо бажаєте залишити відгук про платформу."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Modal",
          "props": {
            "title": "Карта громадської участі",
            "size": "lg",
            "buttonLabel": "Зрозуміло"
          },
          "bind": {
            "modelValue": "$state.showIntro"
          },
          "on": {
            "update:modelValue": {
              "set": "showIntro"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "md"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "На цій карті ви можете побачити всі позначки, які залишили учасники опитування."
                  }
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Ви можете:"
                  }
                },
                {
                  "type": "ul",
                  "style": "bullets",
                  "children": [
                    {
                      "type": "li",
                      "text": "Натиснути на будь-яку позначку, щоб побачити коментарі"
                    },
                    {
                      "type": "li",
                      "text": "Змінювати тип карти (супутник/схема)"
                    },
                    {
                      "type": "li",
                      "text": "Масштабувати карту для детального перегляду"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
