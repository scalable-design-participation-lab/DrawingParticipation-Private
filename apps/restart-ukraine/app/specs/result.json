{
  "version": 1,
  "state": {
    "mapType": "vector",
    "menuOpen": false,
    "supportOpen": false,
    "showIntro": "$query.showIntro",
    "features": [],
    "inspected": null
  },
  "children": [
    {
      "type": "div",
      "style": "screen",
      "children": [
        {
          "type": "Header",
          "props": {
            "leftItems": [
              {
                "label": "Drawing Participation"
              },
              {
                "label": "Гуртомá"
              }
            ]
          },
          "on": {
            "menu": {
              "set": "menuOpen",
              "value": true
            }
          },
          "children": [
            {
              "slot": "right",
              "type": "MapTypeToggle",
              "bind": {
                "modelValue": "$state.mapType"
              },
              "on": {
                "update:modelValue": {
                  "set": "mapType"
                }
              }
            }
          ]
        },
        {
          "type": "Modal",
          "props": {
            "size": "sm"
          },
          "bind": {
            "modelValue": "$state.menuOpen"
          },
          "on": {
            "update:modelValue": {
              "set": "menuOpen"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "direction": "column",
                "gap": "sm"
              },
              "children": [
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/"
                  },
                  "style": "menu-item",
                  "text": "Головна",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/about"
                  },
                  "style": "menu-item",
                  "text": "Про нас",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid"
                  },
                  "style": "menu-item",
                  "text": "Підтримка",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      },
                      {
                        "set": "supportOpen",
                        "value": true
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/result"
                  },
                  "style": "menu-item",
                  "text": "Результати",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                },
                {
                  "type": "Button",
                  "props": {
                    "block": true,
                    "color": "white",
                    "variant": "solid",
                    "to": "/dashboard"
                  },
                  "style": "menu-item",
                  "text": "приладова панель",
                  "on": {
                    "click": [
                      {
                        "set": "menuOpen",
                        "value": false
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "div",
          "style": "map-layer",
          "children": [
            {
              "type": "BackgroundMap",
              "bind": {
                "mapType": "$state.mapType"
              },
              "children": [
                {
                  "slot": "layers",
                  "type": "FeatureLayer",
                  "props": {
                    "icons": {
                      "every day": "/icons/blue.svg",
                      "every week": "/icons/green.svg",
                      "sometimes": "/icons/purple.svg",
                      "only once": "/icons/yellow.svg",
                      "once": "/icons/yellow.svg",
                      "never": "/icons/red.svg",
                      "prohibit": "/icons/prohibit.svg",
                      "heart": "/icons/heart.svg",
                      "love": "/icons/heart.svg",
                      "smile": "/icons/smile.svg",
                      "positive": "/icons/smile.svg",
                      "dislike": "/icons/dislike.svg",
                      "negative": "/icons/dislike.svg",
                      "broken": "/icons/broken.svg",
                      "unsafe": "/icons/broken.svg",
                      "calm": "/icons/calm.svg",
                      "safe": "/icons/calm.svg",
                      "lock": "/icons/lock.svg",
                      "great": "/icons/lock.svg",
                      "trash": "/icons/trash.svg",
                      "pollution": "/icons/pollution.svg",
                      "leaf": "/icons/leaf.svg",
                      "flora-fauna": "/icons/leaf.svg",
                      "default": "/icons/red.svg",
                      "everyday": "/icons/blue.svg",
                      "everyweek": "/icons/green.svg"
                    },
                    "labels": {
                      "prohibit": "Заборонена зона",
                      "pollution": "Точка забруднення",
                      "leaf": "Зелена зона",
                      "flora-fauna": "Флора та фауна",
                      "lock": "Безпечна зона",
                      "great": "Дуже безпечна зона",
                      "calm": "Спокійна зона",
                      "safe": "Безпечна територія",
                      "broken": "Небезпечна зона",
                      "unsafe": "Небезпечна територія",
                      "dislike": "Не подобається",
                      "negative": "Негативне",
                      "heart": "Улюблене",
                      "love": "Улюблене місце",
                      "smile": "Щасливе місце",
                      "positive": "Позитивне",
                      "trash": "Сміття",
                      "every day": "Щоденне відвідування",
                      "everyday": "Щоденне відвідування",
                      "every week": "Щотижневе відвідування",
                      "everyweek": "Щотижневе відвідування",
                      "sometimes": "Випадкове відвідування",
                      "only once": "Одноразове відвідування",
                      "once": "Одноразове відвідування",
                      "never": "Ніколи не відвідував"
                    },
                    "defaultLabel": "Деталі локації",
                    "confirmDelete": "Ви впевнені, що хочете видалити цю відмітку?",
                    "commentIcons": true
                  },
                  "bind": {
                    "features": "$state.features"
                  },
                  "on": {
                    "update:features": {
                      "set": "features"
                    },
                    "inspect": {
                      "set": "inspected"
                    }
                  }
                },
                {
                  "slot": "overlays",
                  "type": "MarkerOverlay",
                  "props": {
                    "positionKey": "position",
                    "lonLat": false,
                    "positioning": "bottom-center",
                    "stopEvent": true
                  },
                  "bind": {
                    "item": "$state.inspected"
                  },
                  "item": {
                    "type": "Panel",
                    "props": {
                      "variant": "card",
                      "padding": "sm"
                    },
                    "children": [
                      {
                        "type": "Stack",
                        "props": {
                          "gap": "xs"
                        },
                        "children": [
                          {
                            "type": "Stack",
                            "props": {
                              "direction": "row",
                              "justify": "between",
                              "align": "center",
                              "gap": "sm"
                            },
                            "children": [
                              {
                                "type": "Text",
                                "bind": {
                                  "text": "$item.title"
                                },
                                "props": {
                                  "weight": "medium",
                                  "size": "sm"
                                }
                              },
                              {
                                "type": "Button",
                                "props": {
                                  "icon": "i-heroicons-x-mark",
                                  "variant": "ghost",
                                  "color": "black",
                                  "size": "xs"
                                },
                                "on": {
                                  "click": {
                                    "set": "inspected",
                                    "value": null
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "type": "Text",
                            "if": "$item.comment",
                            "bind": {
                              "text": "$item.comment"
                            },
                            "props": {
                              "size": "sm"
                            }
                          },
                          {
                            "type": "Text",
                            "if": "!$item.comment",
                            "props": {
                              "size": "sm",
                              "tone": "muted",
                              "text": "Ще ніхто не залишив коментарів для цієї локації."
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Footer",
          "on": {
            "support": {
              "set": "supportOpen",
              "value": true
            }
          }
        },
        {
          "type": "Modal",
          "props": {
            "title": "Допомога",
            "size": "lg",
            "closable": true,
            "buttonLabel": "Повернутися до карти"
          },
          "bind": {
            "modelValue": "$state.supportOpen"
          },
          "on": {
            "update:modelValue": {
              "set": "supportOpen"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "md"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "«Гуртомá» — проєкт зі спільного створення мапи завдяки містянам, який дозволяє дослідити питання використання й ставлення до навколишнього простору."
                  }
                },
                {
                  "type": "Stack",
                  "props": {
                    "gap": "xs"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "as": "h3",
                        "size": "md",
                        "weight": "medium",
                        "text": "Ключові особливості:"
                      }
                    },
                    {
                      "type": "ul",
                      "style": "bullets",
                      "children": [
                        {
                          "type": "li",
                          "text": "Малюйте та позначайте місця, які ви відвідуєте та використовуєте для певної мети"
                        },
                        {
                          "type": "li",
                          "text": "Діліться своїм досвідом про відчуття безпеки та єдності"
                        },
                        {
                          "type": "li",
                          "text": "Робіть внесок у захист довкілля"
                        },
                        {
                          "type": "li",
                          "text": "Знайомтесь з думкою спільноти"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Як долучитися: Використовуйте інструменти на лівій панелі збоку, щоб позначати місця та ділитися своїм досвідом. Ваш внесок дозволить краще зрозуміти, в якому стані міський простір та як його покращити."
                  }
                },
                {
                  "type": "Text",
                  "children": [
                    {
                      "type": "span",
                      "text": "Будь ласка, "
                    },
                    {
                      "type": "a",
                      "props": {
                        "href": "https://forms.gle/6d8GuBSPaingSR4L6",
                        "target": "_blank"
                      },
                      "style": "link",
                      "text": "заповніть форму"
                    },
                    {
                      "type": "span",
                      "text": ", якщо бажаєте залишити відгук про платформу."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Modal",
          "props": {
            "title": "Карта громадської участі",
            "size": "lg",
            "buttonLabel": "Зрозуміло"
          },
          "bind": {
            "modelValue": "$state.showIntro"
          },
          "on": {
            "update:modelValue": {
              "set": "showIntro"
            }
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "md"
              },
              "children": [
                {
                  "type": "Text",
                  "props": {
                    "text": "На цій карті ви можете побачити всі позначки, які залишили учасники опитування."
                  }
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Ви можете:"
                  }
                },
                {
                  "type": "ul",
                  "style": "bullets",
                  "children": [
                    {
                      "type": "li",
                      "text": "Натиснути на будь-яку позначку, щоб побачити коментарі"
                    },
                    {
                      "type": "li",
                      "text": "Змінювати тип карти (супутник/схема)"
                    },
                    {
                      "type": "li",
                      "text": "Масштабувати карту для детального перегляду"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "init": [
    {
      "call": "loadResults"
    }
  ]
}
