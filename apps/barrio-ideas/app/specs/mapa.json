{
  "version": 1,
  "state": {
    "draw": null,
    "features": [],
    "selected": null,
    "inspected": null,
    "sent": false,
    "mapType": "vector"
  },
  "dataSources": {
    "ideas": {
      "kind": "collection",
      "name": "ideas"
    }
  },
  "children": [
    {
      "type": "div",
      "style": "screen",
      "children": [
        {
          "type": "BackgroundMap",
          "props": {
            "centerLonLat": [
              -99.175,
              19.42
            ],
            "zoom": 14,
            "showZoomControl": true
          },
          "bind": {
            "mapType": "$state.mapType"
          },
          "children": [
            {
              "slot": "layers",
              "type": "FeatureLayer",
              "props": {
                "icons": {
                  "heart": "/icons/heart.svg",
                  "broken": "/icons/broken.svg",
                  "smile": "/icons/smile.svg",
                  "default": "/icons/purple.svg"
                },
                "labels": {
                  "heart": "Me gusta",
                  "broken": "Hay que arreglar",
                  "smile": "Idea nueva"
                },
                "defaultLabel": "Idea",
                "commentIcons": true
              },
              "bind": {
                "features": "$data.ideas"
              },
              "on": {
                "inspect": {
                  "set": "inspected"
                }
              }
            },
            {
              "slot": "layers",
              "type": "FeatureLayer",
              "props": {
                "icons": {
                  "heart": "/icons/heart.svg",
                  "broken": "/icons/broken.svg",
                  "smile": "/icons/smile.svg",
                  "default": "/icons/purple.svg"
                },
                "labels": {
                  "heart": "Me gusta",
                  "broken": "Hay que arreglar",
                  "smile": "Idea nueva"
                },
                "defaultLabel": "Idea",
                "editable": true,
                "deletable": true,
                "confirmDelete": "¿Quitar esta marca?"
              },
              "bind": {
                "features": "$state.features",
                "draw": "$state.draw"
              },
              "on": {
                "update:features": {
                  "set": "features"
                },
                "update:draw": {
                  "set": "draw"
                },
                "open": {
                  "set": "selected"
                }
              }
            },
            {
              "slot": "overlays",
              "type": "MarkerOverlay",
              "props": {
                "positionKey": "position",
                "lonLat": false,
                "positioning": "bottom-center",
                "stopEvent": true
              },
              "bind": {
                "item": "$state.selected"
              },
              "item": {
                "type": "Panel",
                "props": {
                  "variant": "card",
                  "padding": "sm"
                },
                "children": [
                  {
                    "type": "Text",
                    "props": {
                      "size": "sm",
                      "weight": "semibold"
                    },
                    "bind": {
                      "text": "$item.title"
                    }
                  },
                  {
                    "type": "FormFields",
                    "props": {
                      "fields": [
                        {
                          "name": "comment",
                          "type": "textarea",
                          "rows": 3,
                          "placeholder": "Cuéntanos por qué"
                        }
                      ],
                      "submitLabel": "Guardar",
                      "gap": "gap-2"
                    },
                    "bind": {
                      "modelValue": "$state.selected"
                    },
                    "on": {
                      "update:modelValue": {
                        "set": "selected"
                      },
                      "submit": [
                        {
                          "call": "saveTo",
                          "args": "ideas"
                        },
                        {
                          "set": "features",
                          "value": []
                        },
                        {
                          "set": "selected",
                          "value": null
                        },
                        {
                          "set": "sent",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "type": "Text",
                    "if": "$errors.saveTo",
                    "bind": {
                      "text": "$errors.saveTo"
                    },
                    "props": {
                      "size": "xs",
                      "tone": "accent"
                    }
                  },
                  {
                    "type": "Button",
                    "props": {
                      "variant": "ghost",
                      "color": "black",
                      "size": "xs"
                    },
                    "text": "Cerrar",
                    "on": {
                      "click": {
                        "set": "selected",
                        "value": null
                      }
                    }
                  }
                ]
              }
            },
            {
              "slot": "overlays",
              "type": "MarkerOverlay",
              "props": {
                "positionKey": "position",
                "lonLat": false,
                "positioning": "bottom-center",
                "stopEvent": true
              },
              "bind": {
                "item": "$state.inspected"
              },
              "item": {
                "type": "Panel",
                "props": {
                  "variant": "card",
                  "padding": "sm"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": {
                      "direction": "row",
                      "justify": "between",
                      "align": "center",
                      "gap": "sm"
                    },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "size": "sm",
                          "weight": "semibold"
                        },
                        "bind": {
                          "text": "$item.title"
                        }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "icon": "i-heroicons-x-mark",
                          "variant": "ghost",
                          "color": "black",
                          "size": "xs"
                        },
                        "on": {
                          "click": {
                            "set": "inspected",
                            "value": null
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "props": {
                      "size": "sm"
                    },
                    "bind": {
                      "text": "$item.comment"
                    }
                  },
                  {
                    "type": "Text",
                    "if": "!$item.comment",
                    "props": {
                      "size": "sm",
                      "tone": "muted",
                      "text": "Sin comentario."
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "Panel",
          "style": "floating-left",
          "props": {
            "variant": "card",
            "padding": "md"
          },
          "children": [
            {
              "type": "Stack",
              "props": {
                "gap": "sm"
              },
              "children": [
                {
                  "type": "StepCard",
                  "props": {
                    "steps": [
                      {
                        "title": "¿Qué quieres marcar?",
                        "text": "Elige un icono y toca el mapa. Con «Zona» puedes dibujar un área: doble clic para cerrarla.",
                        "iconGrid": {
                          "icons": [
                            {
                              "name": "heart",
                              "src": "/icons/heart.svg",
                              "tooltip": "Me gusta",
                              "value": {
                                "type": "Point",
                                "iconName": "heart",
                                "color": "#10b981"
                              }
                            },
                            {
                              "name": "broken",
                              "src": "/icons/broken.svg",
                              "tooltip": "Hay que arreglar",
                              "value": {
                                "type": "Point",
                                "iconName": "broken",
                                "color": "#10b981"
                              }
                            },
                            {
                              "name": "smile",
                              "src": "/icons/smile.svg",
                              "tooltip": "Idea nueva",
                              "value": {
                                "type": "Point",
                                "iconName": "smile",
                                "color": "#10b981"
                              }
                            }
                          ]
                        },
                        "buttons": [
                          {
                            "label": "Zona",
                            "color": "primary",
                            "variant": "outline",
                            "value": {
                              "type": "Polygon",
                              "iconName": "smile"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "on": {
                    "select": {
                      "set": "draw"
                    }
                  }
                },
                {
                  "type": "Text",
                  "if": "$state.draw",
                  "props": {
                    "size": "xs",
                    "tone": "accent",
                    "text": "Toca el mapa para colocar la marca, luego el «+» para escribir."
                  }
                },
                {
                  "type": "Text",
                  "if": "$state.sent",
                  "props": {
                    "size": "sm",
                    "weight": "bold",
                    "text": "¡Gracias! Tu idea ya está en el mapa."
                  }
                },
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "gap": "xs",
                    "align": "baseline"
                  },
                  "children": [
                    {
                      "type": "Text",
                      "props": {
                        "size": "xs",
                        "tone": "muted",
                        "text": "Ideas en el mapa:"
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "size": "xs",
                        "tone": "muted"
                      },
                      "bind": {
                        "text": "$data.ideas.length"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "if": "$sources.ideas.loading",
                  "props": {
                    "size": "xs",
                    "tone": "muted",
                    "text": "Cargando…"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
