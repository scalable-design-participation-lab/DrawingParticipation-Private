{
  "name": "DrawingLayer",
  "description": "Map drawing tools (points, lines, polygons). Reads the drawing/sidebar/route-features stores.",
  "stateful": true,
  "emits": [
    "toggle-comment-popup",
    "toggle-image-upload-popup",
    "show-comment-display"
  ],
  "slots": [],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "projection": {
        "type": "string"
      },
      "showAllPlusIcons": {
        "type": "boolean"
      },
      "enableClick": {
        "type": "boolean"
      },
      "isMapPage": {
        "type": "boolean"
      },
      "showDeleteButton": {
        "type": "boolean"
      },
      "showCommentIcons": {
        "type": "boolean"
      }
    },
    "required": [
      "projection"
    ],
    "additionalProperties": false
  }
}
