{
  "name": "BottomBar",
  "description": "Desktop toolbar (map / list / info / add); the highlighted mode follows the open flags.",
  "stateful": false,
  "emits": [
    "map",
    "list",
    "info",
    "add"
  ],
  "slots": [],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "contributeOpen": {
        "type": "boolean"
      },
      "listOpen": {
        "type": "boolean"
      },
      "infoOpen": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
