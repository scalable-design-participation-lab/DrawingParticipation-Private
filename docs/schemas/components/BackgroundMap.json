{
  "name": "BackgroundMap",
  "description": "Full-size OpenLayers map with a Mapbox raster basemap. Layers and overlays go in slots.",
  "stateful": false,
  "emits": [
    "mapClick",
    "featureClick"
  ],
  "slots": [
    "layers",
    "overlays"
  ],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "center": {
        "description": "View center in the map projection (EPSG:3857 by default).",
        "minItems": 2,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "centerLonLat": {
        "description": "View center as [lon, lat]; wins over `center`.",
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "zoom": {
        "type": "number",
        "minimum": 0,
        "maximum": 22
      },
      "minZoom": {
        "type": "number",
        "minimum": 0,
        "maximum": 22
      },
      "maxZoom": {
        "type": "number",
        "minimum": 0,
        "maximum": 22
      },
      "projection": {
        "type": "string"
      },
      "rotation": {
        "type": "number"
      },
      "pitch": {
        "type": "number"
      },
      "bearing": {
        "type": "number"
      },
      "extent": {
        "description": "Bounds panning, in the map projection. Defaults to one world, so the view cannot drift into the repeated copies where HTML overlays do not render.",
        "minItems": 4,
        "maxItems": 4,
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "mapHeight": {
        "description": "CSS height, e.g. \"100vh\" or \"100%\".",
        "type": "string"
      },
      "showZoomControl": {
        "type": "boolean"
      },
      "mapType": {
        "type": "string",
        "enum": [
          "vector",
          "satellite"
        ]
      },
      "mapboxStyleLight": {
        "description": "Mapbox style id, e.g. \"mapbox/light-v11\".",
        "type": "string"
      },
      "mapboxStyleDark": {
        "type": "string"
      },
      "mapboxToken": {
        "description": "Falls back to runtimeConfig.public.mapboxToken.",
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
