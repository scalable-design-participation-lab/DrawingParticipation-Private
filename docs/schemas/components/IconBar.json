{
  "name": "IconBar",
  "description": "Floating pill of icon buttons: the bottom toolbar of a map app, a row of category chips, a view switcher. `modelValue` is the active value (or the list of them with `multiple`), so the page owns it. An item may carry its own `onClick` action when pressing it does more than change which one is lit.",
  "stateful": false,
  "emits": [
    "update:modelValue",
    "select"
  ],
  "slots": [],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "description": "The buttons, listed. Leave it out and bind `rows` instead to derive them from data.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "label": {
              "description": "Tooltip and accessible name.",
              "type": "string"
            },
            "color": {
              "description": "Colour when active; the theme primary otherwise.",
              "type": "string"
            },
            "onClick": {
              "description": "`{ \"$action\": … }` run when pressed."
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "rows": {
        "description": "Rows to read values off: each distinct `field` becomes a button, so a filter bar shows the categories actually present.",
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "field": {
        "description": "Which key of a row holds the value.",
        "type": "string"
      },
      "first": {
        "description": "Values that always appear, in this order, ahead of anything found in `rows`.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "exclude": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "icons": {
        "description": "value -> icon, for buttons derived from `rows`.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "colors": {
        "description": "value -> colour when active.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "labels": {
        "description": "value -> tooltip; the value itself otherwise.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "modelValue": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "multiple": {
        "type": "boolean"
      },
      "position": {
        "type": "string",
        "enum": [
          "top",
          "bottom",
          "static"
        ]
      },
      "size": {
        "type": "string",
        "enum": [
          "sm",
          "md",
          "lg"
        ]
      }
    },
    "additionalProperties": false
  }
}
