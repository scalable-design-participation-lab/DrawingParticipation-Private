{
  "name": "EntryDetail",
  "description": "Desktop detail panel for one entry: text, gallery, voice notes, links, community contributions. `show-tag` emits the theme to narrow to.",
  "stateful": false,
  "emits": [
    "close",
    "showTag",
    "contribute",
    "approve",
    "delete"
  ],
  "slots": [],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entry": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "contributions": {
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "loading": {
        "type": "boolean"
      },
      "isAdmin": {
        "type": "boolean"
      }
    },
    "required": [
      "entry"
    ],
    "additionalProperties": false
  }
}
