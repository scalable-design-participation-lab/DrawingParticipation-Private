{
  "name": "List",
  "description": "Repeat the `item` template for every row of `items` (bind to `$data.<source>` or a state list), as a stack or a grid. Inside the template use `$item.<field>`.",
  "stateful": false,
  "emits": [],
  "slots": [
    "item"
  ],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {}
      },
      "layout": {
        "type": "string",
        "enum": [
          "stack",
          "grid"
        ]
      },
      "cols": {
        "anyOf": [
          {
            "type": "number",
            "const": 1
          },
          {
            "type": "number",
            "const": 2
          },
          {
            "type": "number",
            "const": 3
          },
          {
            "type": "number",
            "const": 4
          }
        ]
      },
      "gap": {
        "type": "string",
        "enum": [
          "none",
          "xs",
          "sm",
          "md",
          "lg"
        ]
      },
      "empty": {
        "description": "Text shown when there are no items",
        "type": "string"
      },
      "filterKey": {
        "description": "Keep rows whose field equals filterValue (bind filterValue to state; empty = all)",
        "type": "string"
      },
      "filterValue": {},
      "filterIn": {
        "description": "Keep rows whose filterKey is in this set: a list, or the { value: boolean } map a checkbox group or an IconBar emits. An empty selection keeps all.",
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "search": {
        "description": "Case-insensitive text search (bind to state)",
        "type": "string"
      },
      "searchKeys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sortBy": {
        "type": "string"
      },
      "sortDesc": {
        "type": "boolean"
      },
      "near": {
        "description": "Sort nearest-first from this [lon, lat] and give the item template a `distanceKm`. Bind the state `watchLocation` fills.",
        "anyOf": [
          {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "null"
          }
        ]
      },
      "coordinatesKey": {
        "description": "Where a row keeps its position (default \"coordinates\"); a dotted path works.",
        "type": "string"
      },
      "coordinates": {
        "description": "What those numbers are (default \"lonlat\"); map features are usually \"webmercator\".",
        "type": "string",
        "enum": [
          "lonlat",
          "webmercator"
        ]
      },
      "limit": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  }
}
