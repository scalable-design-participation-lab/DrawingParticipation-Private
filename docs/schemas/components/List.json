{
  "name": "List",
  "description": "Repeat the `item` template for every row of `items` (bind to `$data.<source>` or a state list), as a stack or a grid. Inside the template use `$item.<field>`.",
  "stateful": false,
  "emits": [],
  "slots": [
    "item"
  ],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {}
      },
      "layout": {
        "type": "string",
        "enum": [
          "stack",
          "grid"
        ]
      },
      "cols": {
        "anyOf": [
          {
            "type": "number",
            "const": 1
          },
          {
            "type": "number",
            "const": 2
          },
          {
            "type": "number",
            "const": 3
          },
          {
            "type": "number",
            "const": 4
          }
        ]
      },
      "gap": {
        "type": "string",
        "enum": [
          "none",
          "xs",
          "sm",
          "md",
          "lg"
        ]
      },
      "empty": {
        "description": "Text shown when there are no items",
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
