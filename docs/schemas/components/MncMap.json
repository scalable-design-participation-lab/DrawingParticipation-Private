{
  "name": "MncMap",
  "description": "The MNC map: category pins for the visible entries plus the QuickLook card. `selected` / `quickLook` are owned by the page; taps on the empty map emit `add-at` (desktop) or `pick` while `picking`.",
  "stateful": false,
  "emits": [
    "update:selected",
    "update:quickLook",
    "expand",
    "pick",
    "addAt"
  ],
  "slots": [],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "visibleTags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "selected": {
        "anyOf": [
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      },
      "quickLook": {
        "type": "boolean"
      },
      "picking": {
        "type": "boolean"
      },
      "pin": {
        "anyOf": [
          {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "null"
          }
        ]
      },
      "mapType": {
        "type": "string",
        "enum": [
          "vector",
          "satellite"
        ]
      },
      "isMobile": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
