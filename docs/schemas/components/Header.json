{
  "name": "Header",
  "description": "Floating top bar: logo, left nav items, right action items.",
  "stateful": false,
  "emits": [
    "menu"
  ],
  "slots": [
    "logo",
    "menu",
    "right"
  ],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "variant": {
        "type": "string",
        "enum": [
          "pill",
          "text"
        ]
      },
      "leftItems": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "primary": {
              "type": "boolean"
            },
            "target": {
              "description": "Link target, e.g. \"_blank\" for an external site",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "rightItems": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "primary": {
              "type": "boolean"
            },
            "target": {
              "description": "Link target, e.g. \"_blank\" for an external site",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "logoSrc": {
        "type": "string"
      },
      "logoAlt": {
        "type": "string"
      },
      "logoLink": {
        "type": "string"
      },
      "showIcon": {
        "type": "boolean"
      },
      "showColorMode": {
        "type": "boolean"
      },
      "showMenu": {
        "type": "boolean"
      },
      "iconLink": {
        "description": "Where the lab icon links to",
        "type": "string"
      },
      "primaryAccentColor": {
        "description": "Text / icon color for every header button",
        "type": "string"
      },
      "shape": {
        "type": "string",
        "enum": [
          "rounded",
          "rectangular"
        ]
      },
      "z": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "additionalProperties": false
  }
}
