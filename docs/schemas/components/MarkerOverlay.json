{
  "name": "MarkerOverlay",
  "description": "Renders one HTML overlay per item on the map. Put it in the BackgroundMap \"overlays\" slot.",
  "stateful": false,
  "emits": [],
  "slots": [
    "item"
  ],
  "props": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "positionKey": {
        "description": "Item key holding [lon, lat] (default \"position\").",
        "type": "string"
      },
      "lonLat": {
        "description": "Positions are [lon, lat] (default) rather than map coordinates.",
        "type": "boolean"
      },
      "positioning": {
        "type": "string"
      },
      "stopEvent": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
