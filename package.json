    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.25.0",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.8.0",
    "eslint-plugin-format": "^0.1.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
