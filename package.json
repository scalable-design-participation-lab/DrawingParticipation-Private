{
  "name": "@drawing-participation/root",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/scalable-design-participation-lab/DrawingParticipation-Private.git",
  "scripts": {
    "dev:dp": "pnpm --filter drawing-participation dev",
    "dev:hurtoma": "pnpm --filter @drawing-participation/hurtoma dev",
